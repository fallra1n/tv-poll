# Copy to backend/.env for local `go run` (docker-compose reads these
# from your shell / a root .env instead — see docker-compose.yml).

HTTP_ADDR=:8080
METRICS_ADDR=127.0.0.1:9090

DATABASE_URL=postgres://tvpoll:tvpoll@localhost:5432/tvpoll?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0

# Change these before deploying anywhere beyond localhost.
ADMIN_TOKEN=local-dev-admin-token
VOTE_TOKEN_SECRET=local-dev-vote-token-secret-change-me
VOTE_TOKEN_SECRET_PREV=

CORS_ALLOWED_ORIGINS=http://localhost:3000
# false only for local plain-http development — SameSite=None cookies
# require Secure in real browsers, see docs/ai/05-api-contract.md.
COOKIE_SECURE=false

DEFAULT_VOTING_WINDOW_SECONDS=300
RATE_LIMIT_RPS=6
RATE_LIMIT_BURST=60

LOG_LEVEL=info
